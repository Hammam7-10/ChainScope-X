# Local development defaults. This file contains no credentials.
APP_ENV=development
HOST=127.0.0.1
PORT=8000
CHAIN_SCOPE_CHROMA_DIR=data/chroma
CHAIN_SCOPE_POLICY_DIR=data/policies
FASTEMBED_CACHE_PATH=~/.cache/fastembed
# Optional Groq live planning. Secret must be supplied by a local secret manager/environment.
GROQ_MODEL_ID=openai/gpt-oss-20b
# Mock mode is default and does not use an LLM/API key.
# R5 local-only persistence. Supply these values through a local secret store/environment.
# Example formats only; never commit real credentials or passwords.
CHAIN_SCOPE_POSTGRES_DSN=
CHAIN_SCOPE_MONGODB_URI=
CHAIN_SCOPE_MONGODB_DATABASE=chainscope
