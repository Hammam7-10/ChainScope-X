# Local development defaults. This file contains no credentials.
APP_ENV=development
HOST=127.0.0.1
PORT=8000
CHAIN_SCOPE_CHROMA_DIR=data/chroma
CHAIN_SCOPE_POLICY_DIR=data/policies
FASTEMBED_CACHE_PATH=~/.cache/fastembed
# Optional Groq live planning. Secret must be supplied by a local secret manager/environment.
GROQ_MODEL_ID=openai/gpt-oss-20b
# Mock mode is default and does not use an LLM/API key.
# R5 local-only persistence. Supply these values through a local secret store/environment.
# Example formats only; never commit real credentials or passwords.
CHAIN_SCOPE_POSTGRES_DSN=
CHAIN_SCOPE_MONGODB_URI=
CHAIN_SCOPE_MONGODB_DATABASE=chainscope
# Optional native-host Docker Compose bootstrap; passwords remain blank placeholders.
POSTGRES_DB=chainscope_dev
POSTGRES_USER=chainscope_dev
POSTGRES_PASSWORD=
MONGO_INITDB_ROOT_USERNAME=chainscope_admin
MONGO_INITDB_ROOT_PASSWORD=

# R6 Google OpenID Connect. Leave blank to receive an explicit not-configured response.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
# Generate a random value of at least 32 characters; never commit it.
CHAIN_SCOPE_SESSION_SECRET=
# Comma-separated Google subject IDs, not email addresses, for explicit bootstrap admins.
CHAIN_SCOPE_ADMIN_GOOGLE_SUBJECTS=
CHAIN_SCOPE_SESSION_MAX_AGE=28800
# Set true only when serving over HTTPS. Development HTTP defaults to false in app/main.py.
CHAIN_SCOPE_SECURE_COOKIES=false

# Rate limiting. memory is development/test only and is not multi-instance safe.
CHAIN_SCOPE_RATE_LIMIT_BACKEND=memory
CHAIN_SCOPE_RATE_LIMIT_UNAUTHENTICATED=20
CHAIN_SCOPE_RATE_LIMIT_AUTHENTICATED=120
CHAIN_SCOPE_RATE_LIMIT_WINDOW_SECONDS=60
# Only configure networks for proxies you operate and trust.
CHAIN_SCOPE_TRUSTED_PROXY_CIDRS=
