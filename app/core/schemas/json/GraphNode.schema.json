{
  "$defs": {
    "Classification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ],
      "title": "Classification",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "node_id": {
      "minLength": 1,
      "title": "Node Id",
      "type": "string"
    },
    "node_type": {
      "pattern": "^(TOOL|ASSET|TRANSFORMATION|DESTINATION|POLICY|EXECUTION)$",
      "title": "Node Type",
      "type": "string"
    },
    "resource_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resource Id"
    },
    "execution_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execution Id"
    },
    "classification": {
      "anyOf": [
        {
          "$ref": "#/$defs/Classification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "node_id",
    "node_type"
  ],
  "title": "GraphNode",
  "type": "object"
}
