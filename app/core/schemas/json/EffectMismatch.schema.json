{
  "$defs": {
    "Assessment": {
      "enum": [
        "CONFIRMED_VIOLATION",
        "POTENTIAL_RISK",
        "EFFECT_MISMATCH",
        "INCONCLUSIVE",
        "NO_VIOLATION_OBSERVED"
      ],
      "title": "Assessment",
      "type": "string"
    },
    "CoverageStatus": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "FAILED",
        "UNKNOWN"
      ],
      "title": "CoverageStatus",
      "type": "string"
    },
    "EffectType": {
      "enum": [
        "READS",
        "SEARCHES",
        "TRANSFORMS",
        "USES",
        "CREATES",
        "WRITES",
        "TRANSMITS",
        "DELEGATES",
        "REQUIRES_APPROVAL"
      ],
      "title": "EffectType",
      "type": "string"
    },
    "MismatchCategory": {
      "enum": [
        "UNDECLARED_OBSERVED_EFFECT",
        "EXPECTED_EFFECT_NOT_OBSERVED",
        "UNEXPECTED_RESOURCE_OR_DESTINATION",
        "UNEXPECTED_OPERATION",
        "INCOMPLETE_COMPARISON"
      ],
      "title": "MismatchCategory",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "mismatch_id": {
      "minLength": 1,
      "title": "Mismatch Id",
      "type": "string"
    },
    "category": {
      "$ref": "#/$defs/MismatchCategory"
    },
    "execution_id": {
      "minLength": 1,
      "title": "Execution Id",
      "type": "string"
    },
    "tool_id": {
      "minLength": 1,
      "title": "Tool Id",
      "type": "string"
    },
    "invocation_ids": {
      "items": {
        "type": "string"
      },
      "title": "Invocation Ids",
      "type": "array"
    },
    "event_ids": {
      "items": {
        "type": "string"
      },
      "title": "Event Ids",
      "type": "array"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "expected_effect": {
      "anyOf": [
        {
          "$ref": "#/$defs/EffectType"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "observed_effect": {
      "anyOf": [
        {
          "$ref": "#/$defs/EffectType"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "resource_ids": {
      "items": {
        "type": "string"
      },
      "title": "Resource Ids",
      "type": "array"
    },
    "destination_ids": {
      "items": {
        "type": "string"
      },
      "title": "Destination Ids",
      "type": "array"
    },
    "assessment": {
      "$ref": "#/$defs/Assessment"
    },
    "coverage_status": {
      "$ref": "#/$defs/CoverageStatus"
    },
    "explanation": {
      "minLength": 1,
      "title": "Explanation",
      "type": "string"
    }
  },
  "required": [
    "mismatch_id",
    "category",
    "execution_id",
    "tool_id",
    "assessment",
    "coverage_status",
    "explanation"
  ],
  "title": "EffectMismatch",
  "type": "object"
}
